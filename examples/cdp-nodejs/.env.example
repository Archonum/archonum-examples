# --- browsers mode (default): per-country remote browser via the API ---
ARCHONUM_TOKEN=
ARCHONUM_COUNTRY=us
# ARCHONUM_BASE_URL=https://app.archonum.com

# --- gateway mode: resolve a ws debugger URL from the CDP gateway ---
# ARCHONUM_CDP_BASE_URL=http://app.archonum.com:10900
# ARCHONUM_CDP_USERNAME=
# ARCHONUM_CDP_PASSWORD=

# Force a mode (else auto-detected from the credentials above)
# CDP_MODE=browsers

# Page to open (default is the creepjs fingerprint checker)
# TARGET_URL=https://creepjs.org/checker
